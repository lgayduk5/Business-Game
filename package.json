{
  "name": "going-concern",
  "private": true,
  "version": "1.0.0",
  "description": "Going Concern \u2014 a turn-based business strategy game. Civilization for running a company.",
  "type": "module",
  "scripts": {
    "icons": "node scripts/gen-icons.mjs",
    "dev": "npm run icons && vite",
    "build": "npm run icons && npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p engine/tsconfig.json",
    "test": "vitest run",
    "sim": "tsx scripts/sim.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
