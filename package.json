{
  "name": "going-concern",
  "private": true,
  "version": "1.0.0",
  "description": "Going Concern — a turn-based business strategy game. Civilization for running a company.",
  "type": "module",
  "scripts": {
    "icons": "node scripts/gen-icons.mjs",
    "dev": "npm run icons && vite",
    "build": "npm run icons && npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p engine/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "sim": "tsx scripts/sim.ts",
    "sim:ci": "tsx scripts/sim.ts --ci",
    "sim:check": "tsx scripts/sim.ts --check",
    "smoke": "node scripts/ui-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.6",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
