{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Glossary",
  "description": "data/glossary.json — the terms the game links to (GlossaryEntry in engine/src/types.ts); events list them by id in `terms`",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": { "type": "string", "description": "Stable identifier, used in `terms` lists" },
      "term": { "type": "string", "description": "Display name" },
      "def": { "type": "string", "description": "What it means" },
      "why": { "type": "string", "description": "Why it matters in the game" }
    },
    "required": ["id", "term", "def", "why"],
    "additionalProperties": false
  }
}
