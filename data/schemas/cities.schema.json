{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "World",
  "description": "data/cities.json — regions and cities",
  "type": "object",
  "required": ["regions", "cities"],
  "properties": {
    "regions": {
      "type": "object",
      "description": "Region id → {name, short, blurb}",
      "properties": {
        "nae": { "$ref": "#/$defs/region" },
        "naw": { "$ref": "#/$defs/region" },
        "latam": { "$ref": "#/$defs/region" },
        "europe": { "$ref": "#/$defs/region" },
        "mea": { "$ref": "#/$defs/region" },
        "apac": { "$ref": "#/$defs/region" }
      },
      "additionalProperties": false,
      "required": ["nae", "naw", "latam", "europe", "mea", "apac"]
    },
    "cities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "Stable identifier" },
          "name": { "type": "string", "description": "" },
          "region": { "enum": ["nae", "naw", "latam", "europe", "mea", "apac"], "description": "" },
          "x": { "type": "number", "description": "Map x, 0..1000" },
          "y": { "type": "number", "description": "Map y, 0..560" },
          "pop": { "type": "number", "description": "Metro population, millions" },
          "income": { "type": "number", "description": "Income per head vs reference" },
          "wage": { "type": "number", "description": "Wage index" },
          "rent": { "type": "number", "description": "Rent index" },
          "reg": { "type": "number", "description": "Regulatory burden 0..1", "minimum": 0, "maximum": 1 },
          "tax": { "type": "number", "description": "Corporate tax rate" },
          "country": { "type": "string", "description": "Tax jurisdiction (ISO country code). Profits and losses are pooled per country." },
          "fx": { "type": "string", "enum": ["cad"], "description": "The city's own currency, when it is not the region's" },
          "talent": { "type": "number", "description": "Talent pool depth 0..100" },
          "talentQ": { "type": "number", "description": "Average skill of the pool" },
          "growth": { "type": "number", "description": "Annual real growth %" },
          "risk": { "type": "number", "description": "Instability 0..1" },
          "ind": {
            "type": "object",
            "properties": {
              "saas": { "type": "number", "description": "Demand multiplier" },
              "retail": { "type": "number", "description": "Demand multiplier" },
              "mfg": { "type": "number", "description": "Demand multiplier" },
              "logistics": { "type": "number", "description": "Demand multiplier" },
              "energy": { "type": "number", "description": "Demand multiplier" },
              "consulting": { "type": "number", "description": "Demand multiplier" },
              "biotech": { "type": "number", "description": "Demand multiplier" }
            },
            "required": ["saas", "retail", "mfg", "logistics", "energy", "consulting", "biotech"],
            "additionalProperties": false
          },
          "tal": {
            "type": "object",
            "description": "Talent specialisation multipliers by industry",
            "properties": {
              "saas": { "type": "number" },
              "retail": { "type": "number" },
              "mfg": { "type": "number" },
              "logistics": { "type": "number" },
              "energy": { "type": "number" },
              "consulting": { "type": "number" },
              "biotech": { "type": "number" }
            },
            "additionalProperties": false
          },
          "blurb": { "type": "string", "description": "" }
        },
        "required": [
          "id",
          "name",
          "region",
          "x",
          "y",
          "pop",
          "income",
          "wage",
          "rent",
          "reg",
          "tax",
          "talent",
          "talentQ",
          "growth",
          "risk",
          "ind",
          "country",
          "tal",
          "blurb"
        ],
        "additionalProperties": false
      },
      "description": ""
    }
  },
  "$defs": {
    "region": {
      "type": "object",
      "properties": { "name": { "type": "string" }, "short": { "type": "string" }, "blurb": { "type": "string" } },
      "required": ["name", "short", "blurb"],
      "additionalProperties": false,
      "description": "A region: its name, a short label for tight spaces, and a one-line blurb"
    }
  }
}
